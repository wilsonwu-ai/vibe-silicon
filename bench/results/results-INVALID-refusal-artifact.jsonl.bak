, 32);\n\n    -- Registered output\n    process(clk)\n    begin\n        if rising_edge(clk) then\n            if rst = '1' then\n                y_reg <= (others => '0');\n            elsif en = '1' then\n                y_reg <= sum_result;\n            end if;\n        end if;\n    end process;\n\n    y <= y_reg;\n\nend architecture rtl;"}
{"ts": "2026-08-09T17:19:42+00:00", "lang": "vhdl", "task": "mac_array8", "model": "claude-haiku-4-5", "trial": 2, "generated": true, "lints": true, "elaborates": true, "passes": true, "log": "[sim] ALL TESTS PASSED\nsimulation finished @76ns", "seconds": 5.46, "stop_reason": "end_turn", "output_tokens": 1074, "input_tokens": 536, "code": "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity mac_array8 is\n    port (\n        clk    : in  std_logic;\n        rst    : in  std_logic;\n        en     : in  std_logic;\n        a_flat : in  std_logic_vector(63 downto 0);\n        b_flat : in  std_logic_vector(63 downto 0);\n        y      : out signed(31 downto 0)\n    );\nend entity mac_array8;\n\narchitecture rtl of mac_array8 is\n    \n    type signed_array is array (0 to 7) of signed(7 downto 0);\n    \n    signal a : signed_array;\n    signal b : signed_array;\n    \n    signal prod0 : signed(15 downto 0);\n    signal prod1 : signed(15 downto 0);\n    signal prod2 : signed(15 downto 0);\n    signal prod3 : signed(15 downto 0);\n    signal prod4 : signed(15 downto 0);\n    signal prod5 : signed(15 downto 0);\n    signal prod6 : signed(15 downto 0);\n    signal prod7 : signed(15 downto 0);\n    \n    signal sum0 : signed(17 downto 0);\n    signal sum1 : signed(17 downto 0);\n    signal sum2 : signed(19 downto 0);\n    signal sum3 : signed(20 downto 0);\n    signal sum4 : signed(21 downto 0);\n    signal sum5 : signed(22 downto 0);\n    signal sum6 : signed(23 downto 0);\n    signal sum7 : signed(24 downto 0);\n    \n    signal y_next : signed(31 downto 0);\n    signal y_reg  : signed(31 downto 0);\n    \nbegin\n    \n    -- Unpack a_flat and b_flat into signed 8-bit elements (little-endian)\n    unpack_ab : process(a_flat, b_flat)\n    begin\n        for i in 0 to 7 loop\n            a(i) <= signed(a_flat(8*i+7 downto 8*i));\n            b(i) <= signed(b_flat(8*i+7 downto 8*i));\n        end loop;\n    end process unpack_ab;\n    \n    -- Eight signed 8x8 multiplies\n    prod0 <= a(0) * b(0);\n    prod1 <= a(1) * b(1);\n    prod2 <= a(2) * b(2);\n    prod3 <= a(3) * b(3);\n    prod4 <= a(4) * b(4);\n    prod5 <= a(5) * b(5);\n    prod6 <= a(6) * b(6);\n    prod7 <= a(7) * b(7);\n    \n    -- Tree of adders to sum all products\n    sum0 <= resize(prod0, 18) + resize(prod1, 18);\n    sum1 <= resize(prod2, 18) + resize(prod3, 18);\n    sum2 <= resize(sum0, 20) + resize(sum1, 20);\n    sum3 <= resize(prod4, 21) + resize(prod5, 21);\n    sum4 <= resize(prod6, 22) + resize(prod7, 22);\n    sum5 <= resize(sum3, 23) + resize(sum4, 23);\n    sum6 <= resize(sum2, 24) + resize(sum5, 24);\n    sum7 <= resize(sum6, 25);\n    \n    y_next <= resize(sum7, 32);\n    \n    -- Registered output\n    process(clk)\n    begin\n        if rising_edge(clk) then\n            if rst = '1' then\n                y_reg <= (others => '0');\n            elsif en = '1' then\n                y_reg <= y_next;\n            end if;\n        end if;\n    end process;\n    \n    y <= y_reg;\n    \nend architecture rtl;"}
