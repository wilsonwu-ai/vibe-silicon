{"ts": "2026-08-09T17:16:26+00:00", "lang": "vhdl", "task": "int8_mac", "model": "claude-haiku-4-5", "trial": 0, "generated": true, "lints": true, "elaborates": true, "passes": true, "log": "[sim] ALL TESTS PASSED\nsimulation finished @86ns", "seconds": 1.83, "stop_reason": "end_turn", "output_tokens": 286, "input_tokens": 395, "code": "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity int8_mac is\n    port (\n        clk : in  std_logic;\n        rst : in  std_logic;\n        en  : in  std_logic;\n        a   : in  signed(7 downto 0);\n        b   : in  signed(7 downto 0);\n        acc : out signed(31 downto 0)\n    );\nend entity int8_mac;\n\narchitecture rtl of int8_mac is\n    signal acc_reg : signed(31 downto 0);\nbegin\n    process (clk) is\n        variable product : signed(15 downto 0);\n    begin\n        if rising_edge(clk) then\n            if rst = '1' then\n                acc_reg <= (others => '0');\n            elsif en = '1' then\n                product := a * b;\n                acc_reg <= acc_reg + resize(product, 32);\n            end if;\n        end if;\n    end process;\n    \n    acc <= acc_reg;\nend architecture rtl;"}
